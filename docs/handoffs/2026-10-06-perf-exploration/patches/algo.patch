+template <class T>
+void put(std::string& s, const T& v) {
+    s.append(reinterpret_cast<const char*>(&v), sizeof(v));
+}
+// Every output field of a finished search, so two runs compare byte for byte.
+std::string signature(const Engine& e) {
+    std::string s;
+    for (const OutPath& p : e.out_paths()) {
+        put(s, p.score_base); put(s, p.score_combo); put(s, p.score_sp);
+        put(s, p.score_solo); put(s, p.score_accents); put(s, p.score_ghosts);
+        put(s, p.var_point); put(s, p.depth); put(s, p.act_begin); put(s, p.act_end);
+        put(s, p.bank_begin); put(s, p.bank_end); put(s, p.tied_count);
+    }
+    s += '|';
+    for (const OutAct& a : e.out_acts()) {
+        put(s, a.act_node); put(s, a.deact_edge); put(s, a.sq_begin); put(s, a.sq_end);
+        put(s, a.e_offset); put(s, a.final_sp_end); put(s, a.end_begin); put(s, a.end_end);
+        put(s, a.bank_begin); put(s, a.bank_end); put(s, a.skip_begin); put(s, a.skip_end);
+        put(s, a.sqout_phrase);
+    }
+    s += '|';
+    for (const OutSq& q : e.out_sqs()) { put(s, q.kind); put(s, q.offset); }
+    s += '|';
+    for (const SpEndStep& q : e.out_ends()) { put(s, q.tick); put(s, q.end_tick); put(s, q.kind); }
+    s += '|';
+    for (int64_t t : e.out_ticks()) put(s, t);
+    return s;
+}
+// A readable listing of a finished search's paths, for a differing chart.
+std::string describe(const Engine& e, const Enum& en) {
+    std::string s;
+    char buf[256];
+    for (const OutPath& p : e.out_paths()) {
+        const int64_t sc = (int64_t)p.score_base + p.score_combo + p.score_sp + p.score_solo +
+                           p.score_accents + p.score_ghosts;
+        std::snprintf(buf, sizeof buf, "\n    depth=%d score=%lld sp=%d tied=%d varpt=%d acts:",
+                      p.depth, (long long)sc, p.score_sp, p.tied_count, p.var_point);
+        s += buf;
+        for (int32_t k = p.act_begin; k < p.act_end; ++k) {
+            const OutAct& a = e.out_acts()[(size_t)k];
+            const int64_t tick = en.node_views[(size_t)a.act_node].tick;
+            const int64_t dtick = a.deact_edge >= 0
+                                      ? en.node_views[(size_t)en.edge_views[(size_t)a.deact_edge].dest].tick
+                                      : -1;
+            std::snprintf(buf, sizeof buf, " [act@%lld bars=%d skips=%d e=%.1f end@%lld sq=",
+                          (long long)tick, a.bank_end - a.bank_begin, a.skip_end - a.skip_begin,
+                          a.e_offset, (long long)dtick);
+            s += buf;
+            for (int32_t q = a.sq_begin; q < a.sq_end; ++q) {
+                std::snprintf(buf, sizeof buf, "%s%.1f,", e.out_sqs()[(size_t)q].kind ? "out" : "in",
+                              e.out_sqs()[(size_t)q].offset);
+                s += buf;
+            }
+            s += "]";
+        }
+    }
+    return s;
+}
