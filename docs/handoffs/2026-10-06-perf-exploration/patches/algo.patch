+struct ExpEnv {
+    std::string log;   // HYDRA_EXP_LOG: run the shadow passes, append a line per search
+    int xdom_real = 0; // HYDRA_XDOM=2: the returned result uses dominance pruning
+    bool dump = false; // HYDRA_EXP_DUMP: list both runs' paths when a pass differs
+};
+const ExpEnv& exp_env() {
+    static const ExpEnv env = [] {
+        ExpEnv e;
+        char* s = nullptr;
+        size_t len = 0;
+        if (_dupenv_s(&s, &len, "HYDRA_EXP_LOG") == 0 && s) e.log = s;
+        std::free(s);
+        s = nullptr;
+        if (_dupenv_s(&s, &len, "HYDRA_XDOM") == 0 && s) e.xdom_real = std::atoi(s);
+        std::free(s);
+        s = nullptr;
+        if (_dupenv_s(&s, &len, "HYDRA_EXP_DUMP") == 0 && s) e.dump = true;
+        std::free(s);
+        return e;
+    }();
+    return env;
+}
+std::mutex& exp_mutex() {
+    static std::mutex m;
+    return m;
+}
