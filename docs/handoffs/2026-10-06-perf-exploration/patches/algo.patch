+// --- PERF EXPERIMENT (algo) ----------------------------------------------
+// ub_[n]: the most points any path standing on node n could still add, with
+// every branch free and every backend row at its best. lb_[n] (base nodes):
+// the points a path adds if it never activates again.
+void Engine::build_bounds() {
+    const size_t nn = en_.node_views.size();
+    ub_.assign(nn, 0);
+    lb_.assign(nn, 0);
+    std::vector<int32_t> order(nn);
+    for (size_t i = 0; i < nn; ++i) order[i] = (int32_t)i;
+    std::sort(order.begin(), order.end(), [this](int32_t a, int32_t b) {
+        return node(a).tick > node(b).tick;
+    });
+    auto adv_w = [this](int32_t ei) -> int64_t {
+        const EdgeView& e = edge(ei);
+        return (int64_t)e.basescore + e.comboscore + e.spscore + e.soloscore + e.accentscore +
+               e.ghostscore;
+    };
+    auto branch_w = [this](int32_t from) -> int64_t {
+        const NodeView& n = node(from);
+        const EdgeView& e = edge(n.branch_edge);
+        if (!n.is_sp) return e.frontend_points;
+        int64_t sum = 0;
+        for (const BackendSqueeze& b : eobj(n.branch_edge)->backends) {
+            const int32_t paid = core::paid_by_sp_walk(b.offset()) ? b.points : 0;
+            int64_t best = std::numeric_limits<int64_t>::min();
+            for (core::SqOutPosition pos :
+                 {core::SqOutPosition::NoSqOut, core::SqOutPosition::Before,
+                  core::SqOutPosition::Exact, core::SqOutPosition::After})
+                best = std::max<int64_t>(best, core::backend_row_value(b.offset(), b.points,
+                                                                       b.sqout_points, pos,
+                                                                       backend_leeway_ms_) -
+                                                   paid);
+            sum += best;
+        }
+        return sum;
+    };
+    // Process in descending tick: an advance edge always goes to a later tick,
+    // and a branch edge stays on its tick, so everything read is done.
+    for (int32_t ni : order) {
+        const NodeView& n = node(ni);
+        if (n.adv_edge < 0) continue;
+        const int32_t d = edge(n.adv_edge).dest;
+        int64_t after = ub_[(size_t)d];
+        const NodeView& dn = node(d);
+        if (dn.branch_edge >= 0)
+            after = std::max(after, branch_w(d) + ub_[(size_t)edge(dn.branch_edge).dest]);
+        ub_[(size_t)ni] = adv_w(n.adv_edge) + after;
+        if (!n.is_sp) lb_[(size_t)ni] = adv_w(n.adv_edge) + lb_[(size_t)d];
+    }
+}
