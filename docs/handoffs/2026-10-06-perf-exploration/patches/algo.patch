+void Engine::exp_after_reduce() {
+    const int64_t n = (int64_t)cur_.size();
+    bool any_drop = false;
+    std::vector<uint8_t> drop;
+    const bool score_mode = depth_mode_ == DepthMode::Scores;
+    const bool huge = depth_value_ > 100000;
+
+    if (exp_.xdom && !huge) {
+        drop.assign((size_t)n, 0);
+        struct E {
+            uint64_t rc;
+            int32_t sp;
+            int64_t score;
+            int32_t idx;
+            bool elig;
+        };
+        std::vector<E> v;
+        for (int32_t i = 0; i < (int32_t)n; ++i) {
+            const Path& p = cur_[(size_t)i];
+            if (p.node < 0 || node(p.node).is_sp || p.spent || p.banked_ahead) continue;
+            v.push_back(E{ready_class(p), p.sp, p.score, i, exp_eligible(p)});
+        }
+        std::sort(v.begin(), v.end(), [](const E& a, const E& b) {
+            if (a.rc != b.rc) return a.rc < b.rc;
+            return a.sp > b.sp;
+        });
+        const size_t K = (size_t)depth_value_ + 1;
+        std::vector<int64_t> top;  // distinct eligible scores, descending, at most K
+        size_t i = 0;
+        while (i < v.size()) {
+            size_t j = i;
+            if (i == 0 || v[i].rc != v[i - 1].rc) top.clear();
+            while (j < v.size() && v[j].rc == v[i].rc && v[j].sp == v[i].sp) ++j;
+            for (size_t k = i; k < j; ++k) {
+                if (!v[k].elig) continue;
+                const int64_t s = v[k].score;
+                if (std::find(top.begin(), top.end(), s) != top.end()) continue;
+                top.insert(std::upper_bound(top.begin(), top.end(), s, std::greater<int64_t>()), s);
+                if (score_mode && top.size() > K) top.pop_back();
+            }
+            for (size_t k = i; k < j; ++k) {
+                if (top.empty()) continue;
+                const int64_t s = v[k].score;
+                bool out;
+                if (score_mode) {
+                    out = top.size() >= K && top[K - 1] > s;
+                } else {
+                    out = s + depth_value_ < top.front();
+                }
+                if (out && exp_.trace) {
+                    // The highest-scoring path with at least this meter.
+                    int32_t a = -1;
+                    for (size_t q = 0; q < j; ++q) {
+                        if (v[q].rc != v[k].rc || !v[q].elig) continue;
+                        if (a < 0 || v[q].score > cur_[(size_t)a].score) a = v[q].idx;
+                    }
+                    auto desc = [this](const Path& p) {
+                        char b[160];
+                        std::string r;
+                        std::snprintf(b, sizeof b, "score=%lld sp=%d skips=%d acts:",
+                                      (long long)p.score, p.sp, p.currentskips);
+                        r += b;
+                        std::vector<int32_t> chain;
+                        for (int32_t t = p.act_tail; t >= 0; t = acts_[(size_t)t].parent)
+                            chain.push_back(t);
+                        for (size_t c = chain.size(); c-- > 0;) {
+                            const Act& ac = acts_[(size_t)chain[c]];
+                            std::snprintf(b, sizeof b, " @%lld(sq%d)",
+                                          (long long)node(ac.act_node).tick, sq_count(ac.sq_tail));
+                            r += b;
+                        }
+                        return r;
+                    };
+                    char b[96];
+                    std::snprintf(b, sizeof b, "\n   drop at tick %lld: B ",
+                                  (long long)node(cur_[(size_t)v[k].idx].node).tick);
+                    trace_ += b;
+                    trace_ += desc(cur_[(size_t)v[k].idx]);
+                    trace_ += "\n                       A ";
+                    if (a >= 0) trace_ += desc(cur_[(size_t)a]);
+                }
+                if (out) {
+                    ++stats_.xdom_hits;
+                    if (exp_.xdom == 2) drop[(size_t)v[k].idx] = 1, any_drop = true;
+                }
+            }
+            i = j;
+        }
+    }
+
+    if (exp_.bound_oracle || exp_.bound_live) {
+        if (drop.empty()) drop.assign((size_t)n, 0);
+        int64_t floor = exp_.bound_floor;
+        bool have_floor = exp_.bound_oracle;
+        if (exp_.bound_live && !no_skips_ && !target_act_ticks_ && !huge) {
+            // Guaranteed finishes: a waiting path that never activates again.
+            std::vector<int64_t> lbs;
+            for (const Path& p : cur_) {
+                if (!exp_eligible(p)) continue;
+                if (p.node < 0) lbs.push_back(p.score);
+                else if (!node(p.node).is_sp) lbs.push_back(p.score + lb_[(size_t)p.node]);
+            }
+            std::sort(lbs.begin(), lbs.end(), std::greater<int64_t>());
+            lbs.erase(std::unique(lbs.begin(), lbs.end()), lbs.end());
+            int64_t live = 0;
+            bool have_live = false;
+            if (score_mode) {
+                if (lbs.size() > (size_t)depth_value_) {
+                    live = lbs[(size_t)depth_value_];
+                    have_live = true;
+                }
+            } else if (!lbs.empty()) {
+                live = lbs.front() - depth_value_;
+                have_live = true;
+            }
+            if (have_live && (!have_floor || live > floor)) floor = live, have_floor = true;
+        }
+        if (have_floor) {
+            for (int64_t i = 0; i < n; ++i) {
+                const Path& p = cur_[(size_t)i];
+                const int64_t ub = p.score + (p.node < 0 ? 0 : ub_[(size_t)p.node]);
+                if (ub < floor) {
+                    ++stats_.bound_hits;
+                    drop[(size_t)i] = 1;
+                    any_drop = true;
+                }
+            }
+        }
+    }
+
+    if (any_drop) {
+        int32_t w = 0;
+        for (int64_t i = 0; i < n; ++i)
+            if (!drop[(size_t)i]) {
+                if (w != i) cur_[(size_t)w] = cur_[(size_t)i];
+                ++w;
+            }
+        cur_.resize((size_t)w);
+    }
+
+    const int64_t m = (int64_t)cur_.size();
+    stats_.frontier_sum += m;
+    stats_.max_frontier = std::max(stats_.max_frontier, m);
+    ++stats_.iters;
+    for (const Path& p : cur_) {
+        if (p.node < 0) continue;
+        if (!node(p.node).is_sp) ++stats_.base_steps;
+        if (node(p.node).branch_edge < 0) ++stats_.quiet_steps;
+    }
+}
