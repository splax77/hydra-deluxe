+// PERF EXPERIMENT (scratch only): single-thread engine timing over a folder.
+//   hydra_bench --engine <folder> [--cache <db>] [--reps N] [--out <file>]
+// Settings come from the exe-side ini, as hydra_batch reads them. Per chart:
+// parse, a throwaway ScoreGraph build, analyze_chart (N reps), prepare_row.
+// Prints the sums and an FNV hash of every prepared row, so two builds can be
+// compared for identical output.
+static uint64_t fnv(uint64_t h, const void* p, size_t n) {
+    const unsigned char* b = static_cast<const unsigned char*>(p);
+    for (size_t i = 0; i < n; ++i) { h ^= b[i]; h *= 1099511628211ULL; }
+    return h;
+}
+static uint64_t fnv_str(uint64_t h, const std::string& s) {
+    uint64_t n = s.size();
+    h = fnv(h, &n, sizeof n);
+    return fnv(h, s.data(), s.size());
+}
+template <class T>
+static uint64_t fnv_opt(uint64_t h, const std::optional<T>& o) {
+    unsigned char has = o.has_value();
+    h = fnv(h, &has, 1);
+    if (o) h = fnv(h, &*o, sizeof(T));
+    return h;
+}
+static uint64_t row_hash(const store::PreparedRow& r) {
+    uint64_t h = 1469598103934665603ULL;
+    h = fnv_str(h, r.bestpath);
+    uint64_t n = r.structure.size();
+    h = fnv(h, &n, sizeof n);
+    h = fnv(h, r.structure.data(), r.structure.size());
+    for (const auto& node : r.nodes) {
+        h = fnv_str(h, node.hash);
+        n = node.payload.size();
+        h = fnv(h, &n, sizeof n);
+        h = fnv(h, node.payload.data(), node.payload.size());
+    }
+    const store::PathSummary& s = r.summary;
+    h = fnv_opt(h, s.score); h = fnv_opt(h, s.actcount); h = fnv_opt(h, s.maxskip);
+    h = fnv_opt(h, s.hardest_ms); h = fnv_opt(h, s.avgmult); h = fnv_opt(h, s.notecount);
+    h = fnv_opt(h, s.sqin_count); h = fnv_opt(h, s.sqout_count); h = fnv_opt(h, s.pathcount);
+    h = fnv_opt(h, s.stars);
+    return h;
+}
+
+static void engine_mode(const std::string& folder, const std::string& cachedb, int reps,
+                        const std::string& outpath) {
+    store::ChartLibraryCache cache;
+    std::unique_ptr<store::RecordStore> cstore;
+    if (!cachedb.empty()) {
+        cstore = std::make_unique<store::RecordStore>(cachedb, core::RulesStamp::of(g_rules));
+        cache = cstore->chart_library_cache();
+    }
+    auto [items, errors] = app::discover_charts({folder}, app::ScanCallbacks{},
+                                                cache.empty() ? nullptr : &cache);
+    app::Settings st = app::Settings::load();
+    st.rules = g_rules;
+    app::BatchRun run = st.batch_run();
+    const app::AnalysisSettings& settings = run.settings;
+    std::unordered_set<std::string> seen;
+    double t_parse = 0, t_graph = 0, t_an = 0, t_prep = 0, t_gdel = 0;
+    for (double& d : g_perf) d = 0;
+    int n = 0, failed = 0;
+    uint64_t all = 1469598103934665603ULL;
+    std::ofstream out;
+    if (!outpath.empty()) out.open(hydra::os_path(outpath), std::ios::binary | std::ios::trunc);
+    for (const app::ScanItem& it : items) {
+        if (!seen.insert(it.md5).second) continue;
+        auto t = clk::now();
+        std::optional<Song> song;
+        try {
+            song.emplace(load_songpath_with_notes(it.notespath, settings.prodrums, settings.bass2x,
+                                                  settings.difficulty, settings.rules));
+        } catch (const std::exception&) {
+            ++failed;
+            continue;
+        }
+        t_parse += secs_since(t);
+        t = clk::now();
+        {
+            ScoreGraph g(*song,
+                         std::optional<int>(graph_build_cap(settings.sp_cap, song->sp_phrase_count())),
+                         fill_rule_for(settings.legacy_fill_deadline), settings.rules);
+            t_graph += secs_since(t);
+            t = clk::now();
+        }
+        t_gdel += secs_since(t);
+        std::optional<HydraRecord> rec;
+        t = clk::now();
+        try {
+            for (int r = 0; r < reps; ++r) rec = analyze_chart(*song, settings);
+        } catch (const std::exception&) {
+            ++failed;
+            continue;
+        }
+        t_an += secs_since(t);
+        t = clk::now();
+        store::PreparedRow row = store::prepare_row(
+            store::RecordKey{it.md5, run.chartmode, run.cap_query(), run.lens}, *rec);
+        t_prep += secs_since(t);
+        const uint64_t h = row_hash(row);
+        all = fnv(all, &h, sizeof h);
+        if (out) out << it.md5 << ' ' << std::hex << h << std::dec << '\n';
+        ++n;
+    }
+    std::printf("charts %d failed %d | parse %.3fs | graph %.3fs | analyze x%d %.3fs | "
+                "prepare %.3fs | hash %016llx\n",
+                n, failed, t_parse, t_graph, reps, t_an, t_prep,
+                static_cast<unsigned long long>(all));
+    std::printf("graph destroy %.3fs | probes:", t_gdel);
+    for (int i = 0; i < 16; ++i) std::printf(" [%d]%.3f", i, g_perf[i]);
+    std::printf("\n");
+}
