+// PERF 6b: Chord::notes(true)'s order without touching the heap. The notes
+// in lane order, then a stable insertion sort on basescore: a stable sort's
+// output is fully determined, so this is the same order.
+struct NoteList {
+    std::array<ChordNote, 5> n;
+    size_t count = 0;
+    size_t size() const { return count; }
+    const ChordNote& operator[](size_t i) const { return n[i]; }
+};
+
+NoteList sorted_notes(const Chord& chord) {
+    NoteList out;
+    for (int c = static_cast<int>(NoteColor::Kick); c <= static_cast<int>(NoteColor::Green); ++c) {
+        const std::optional<ChordNote>& slot = chord.at(static_cast<NoteColor>(c));
+        if (slot) out.n[out.count++] = *slot;
+    }
+    for (size_t i = 1; i < out.count; ++i) {
+        const ChordNote x = out.n[i];
+        const int bx = x.basescore();
+        size_t j = i;
+        while (j > 0 && bx < out.n[j - 1].basescore()) {
+            out.n[j] = out.n[j - 1];
+            --j;
+        }
+        out.n[j] = x;
+    }
+    return out;
+}
+
