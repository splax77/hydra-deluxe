+namespace {
+
+// PERF EXPERIMENT: parse_track's walk, with what to keep left to callbacks.
+// on_meta(meta_type, payload, plen, pending) and on_note(high, d1, d2,
+// pending) return true when they emitted a message; the walk then starts a
+// fresh delta, exactly as parse_track does when it pushes one.
+template <class OnMeta, class OnNote>
+void walk_track(const uint8_t* data, size_t pos, size_t end, OnMeta&& on_meta,
+                OnNote&& on_note) {
+    int64_t pending = 0;
+    int running = 0;
+    while (pos < end) {
+        pending += static_cast<int64_t>(read_varlen(data, pos, end));
+        if (pos >= end) break;
+        uint8_t b = data[pos];
+        int status;
+        if (b & 0x80) {
+            status = b;
+            ++pos;
+            if (b != 0xFF) running = b;
+        } else if (running) {
+            status = running;
+        } else {
+            break;
+        }
+        if (status == 0xFF) {
+            if (pos >= end) break;
+            int meta_type = data[pos++];
+            const uint64_t length = read_message_length(data, pos, end);
+            const uint8_t* payload = data + pos;
+            size_t avail = end - pos;
+            size_t plen = std::min<size_t>(length, avail);
+            pos += length;
+            if (on_meta(meta_type, payload, plen, pending)) pending = 0;
+            continue;
+        }
+        if (status == 0xF0 || status == 0xF7) {
+            const uint64_t length = read_message_length(data, pos, end);
+            pos += length;
+            continue;
+        }
+        int high = status & 0xF0;
+        int nbytes = channel_data_len(high);
+        if (nbytes < 0) break;
+        if (pos + static_cast<size_t>(nbytes) > end) break;
+        uint8_t d1 = data[pos];
+        uint8_t d2 = nbytes > 1 ? data[pos + 1] : 0;
+        pos += nbytes;
+        if (high == 0x90 || high == 0x80) {
+            if (on_note(high, d1, d2, pending)) pending = 0;
+        }
+    }
+}
+
+// The name parse_track would give this track (D78), from a walk that keeps
+// nothing. Throws where parse_track throws.
+std::string track_name_of(const uint8_t* data, size_t pos, size_t end) {
+    std::string name;
+    bool named = false, name_recognized = false;
+    walk_track(
+        data, pos, end,
+        [&](int meta_type, const uint8_t* payload, size_t plen, int64_t) {
+            if (meta_type == 0x03 && !name_recognized) {
+                std::string s = decode_latin1(payload, plen);
+                const bool recognized = recognized_track_name(s);
+                if (recognized || !named) {
+                    name = std::move(s);
+                    named = true;
+                    name_recognized = recognized;
+                }
+            }
+            return false;
+        },
+        [](int, uint8_t, uint8_t, int64_t) { return false; });
+    return name;
+}
