+
+// PERF EXPERIMENT (scratch only): parse-only timing and a digest of every
+// parsed Song (sequence, maps, display fields) and its stored dynamics blob.
+//   hydra_bench --parse <folder | list.txt> [--reps N] [--out <file>] [--nodyn]
+// A .txt argument lists notes paths, one per line. Failures hash their what().
+static uint64_t song_digest(const Song& s) {
+    uint64_t h = 1469598103934665603ULL;
+    auto v = [&](const auto& x) { h = fnv(h, &x, sizeof x); };
+    v(s.tick_resolution());
+    for (const auto& [k, x] : s.tpm_changes) { v(k); v(x); }
+    for (const auto& [k, x] : s.bpm_changes) { v(k); v(x); }
+    for (const auto& [k, x] : s.timesig_changes) { v(k); v(x.first); v(x.second); }
+    uint64_t n = s.sequence.size();
+    v(n);
+    for (const SongTimestamp& ts : s.sequence) {
+        v(ts.timecode.ticks());
+        double ms = ts.timecode.ms(), md = ts.timecode.measures_decimal();
+        v(ms); v(md);
+        for (int i = 0; i < 3; ++i) v(ts.timecode.measure_beats_ticks()[i]);
+        for (int c = 1; c <= 5; ++c) {
+            const auto& o = ts.chord.at(static_cast<NoteColor>(c));
+            unsigned char has = o.has_value();
+            v(has);
+            if (o) { v(o->colortype); v(o->dynamictype); v(o->cymbaltype); v(o->is2x); }
+        }
+        v(ts.flag_solo); v(ts.flag_sp);
+        h = fnv_opt(h, ts.activation_length);
+        h = fnv_opt(h, ts.sp_phrase_start);
+    }
+    for (const auto& f : s.features) h = fnv_str(h, f);
+    v(s.dynamics_enabled);
+    h = fnv_opt(h, s.dynamics_late_tag_tick);
+    v(s.dynamics_marks_before_tag);
+    h = fnv_opt(h, s.chart_offset_s);
+    for (const auto& p : s.practice_sections) { v(p.tick); h = fnv_str(h, p.name); }
+    for (const auto& p : s.solo_sections) { v(p.first); v(p.last); }
+    return h;
+}
+
+static void parse_mode(const std::string& arg, int reps, const std::string& outpath, bool dyn) {
+    std::vector<std::string> paths;
+    if (arg.size() > 4 && arg.substr(arg.size() - 4) == ".txt") {
+        std::ifstream in(hydra::os_path(arg));
+        std::string line;
+        while (std::getline(in, line)) {
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            if (!line.empty()) paths.push_back(line);
+        }
+    } else {
+        auto [items, errors] = app::discover_charts({arg}, app::ScanCallbacks{}, nullptr);
+        std::unordered_set<std::string> seen;
+        for (const app::ScanItem& it : items)
+            if (seen.insert(it.md5).second) paths.push_back(it.notespath);
+    }
+    app::Settings st = app::Settings::load();
+    st.rules = g_rules;
+    app::BatchRun run = st.batch_run();
+    const app::AnalysisSettings& settings = run.settings;
+    double t_parse = 0, t_dyn = 0;
+    int n = 0, failed = 0;
+    uint64_t all = 1469598103934665603ULL;
+    std::ofstream out;
+    if (!outpath.empty()) out.open(hydra::os_path(outpath), std::ios::binary | std::ios::trunc);
+    for (const std::string& p : paths) {
+        uint64_t h = 0;
+        double best = 1e30;
+        std::string fail;
+        for (int r = 0; r < reps; ++r) {
+            auto t = clk::now();
+            try {
+                Song song = load_songpath_with_notes(p, settings.prodrums, settings.bass2x,
+                                                     settings.difficulty, settings.rules);
+                const double dt = secs_since(t);
+                best = std::min(best, dt);
+                if (r == 0) {
+                    h = song_digest(song);
+                    if (dyn) {
+                        auto t2 = clk::now();
+                        auto e = app::dynamics_entry_from_analysis("md5", song, settings.bass2x,
+                                                                   settings.difficulty,
+                                                                   settings.prodrums);
+                        t_dyn += secs_since(t2);
+                        if (e) h = fnv(h, e->blob.data(), e->blob.size());
+                    }
+                }
+            } catch (const std::exception& e) {
+                best = std::min(best, secs_since(t));
+                fail = std::string(typeid(e).name()) + ": " + e.what();
+                h = fnv_str(1469598103934665603ULL, fail);
+            }
+        }
+        t_parse += best;
+        if (!fail.empty()) ++failed;
+        all = fnv(all, &h, sizeof h);
+        if (out) {
+            out << p << '\t' << static_cast<long long>(best * 1e6) << '\t' << std::hex << h
+                << std::dec;
+            if (!fail.empty()) out << "\tFAIL " << fail;
+            out << '\n';
+        }
+        ++n;
+    }
+    std::printf("charts %d failed %d | parse(best of %d) %.3fs | dyn %.3fs | hash %016llx\n", n,
+                failed, reps, t_parse, t_dyn, static_cast<unsigned long long>(all));
+}
