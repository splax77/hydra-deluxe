+void ChartParser::load_sections_lean(const std::vector<uint8_t>& data, char mix_digit,
+                                     const std::string& drum_section) {
+    const std::string_view text(reinterpret_cast<const char*>(data.data()), data.size());
+    enum class Mode { Out, Full, Drums, Events, Skip };
+    Mode mode = Mode::Out;
+    std::optional<ChartSection> wip;
+    std::vector<ChartLine> drums;
+    std::vector<SongSection> events;
+    size_t pos = 0;
+    while (pos < text.size()) {
+        const size_t nl = text.find('\n', pos);
+        const size_t stop = nl == std::string_view::npos ? text.size() : nl;
+        const std::string_view line = trim_view(text.substr(pos, stop - pos));
+        pos = nl == std::string_view::npos ? text.size() : nl + 1;
+
+        if (mode != Mode::Out) {
+            if (line == "{") continue;
+            if (line == "}") {
+                // A later section of the same name replaces the earlier one,
+                // as the map assignment in load_sections does.
+                switch (mode) {
+                    case Mode::Full: sections_[wip->name] = std::move(*wip); wip.reset(); break;
+                    case Mode::Drums:
+                        drum_lines_ = std::move(drums);
+                        drums.clear();
+                        have_drum_lines_ = true;
+                        break;
+                    case Mode::Events:
+                        event_sections_ = std::move(events);
+                        events.clear();
+                        have_event_sections_ = true;
+                        break;
+                    default: break;
+                }
+                mode = Mode::Out;
+                continue;
+            }
+            const size_t eq = line.find('=');
+            std::string_view lhs = line.substr(0, eq), rhs;
+            if (eq != std::string_view::npos) {
+                const size_t eq2 = line.find('=', eq + 1);
+                rhs = line.substr(eq + 1, eq2 == std::string_view::npos ? std::string_view::npos
+                                                                         : eq2 - eq - 1);
+            }
+            lhs = trim_view(lhs);
+            rhs = trim_view(rhs);
+            if (mode == Mode::Full) {
+                wip->add(ChartDataEntry(lhs, rhs, mix_digit));
+            } else if (mode == Mode::Drums) {
+                const ChartLine l = classify_chart_line(lhs, rhs, mix_digit, nullptr);
+                if (l.kind != LineKind::Prop) drums.push_back(l);
+            } else if (mode == Mode::Events) {
+                std::string_view ev;
+                const ChartLine l = classify_chart_line(lhs, rhs, mix_digit, &ev);
+                if (l.kind == LineKind::Event) {
+                    std::string name;
+                    if (section_name_of(std::string(ev), &name))
+                        events.push_back({l.tick, std::move(name)});
+                }
+            } else {
+                classify_chart_line(lhs, rhs, mix_digit, nullptr);
+            }
+        } else {
+            std::string_view bracket;
+            if (!find_section_header(line, &bracket))
+                throw ChartFileError("expected a [section] header");
+            const std::string_view name = bracket.substr(1, bracket.size() - 2);
+            if (name == "Song" || name == "SyncTrack") {
+                ChartSection s;
+                s.name = std::string(name);
+                wip = std::move(s);
+                mode = Mode::Full;
+            } else if (name == drum_section) {
+                drums.clear();
+                mode = Mode::Drums;
+            } else if (name == "Events") {
+                events.clear();
+                mode = Mode::Events;
+            } else {
+                mode = Mode::Skip;
+            }
+        }
+    }
+}
