+// ---- PERF EXPERIMENT: a lean .chart line reader ---------------------------
+// The same answers and the same exceptions as ChartDataEntry, with no string
+// built for a well-formed number. Anything unusual goes to the original
+// function, so its exact acceptance rules still decide.
+
+// The leading [-]digits of w when there are 1..max_digits of them, read as
+// strtol/strtoll would; false sends the caller to the original function.
+bool fast_leading_int(std::string_view w, size_t max_digits, int64_t& out) {
+    size_t i = 0;
+    const bool neg = !w.empty() && w[0] == '-';
+    if (neg) i = 1;
+    const size_t d0 = i;
+    int64_t v = 0;
+    while (i < w.size() && w[i] >= '0' && w[i] <= '9') {
+        if (i - d0 >= max_digits) return false;
+        v = v * 10 + (w[i] - '0');
+        ++i;
+    }
+    if (i == d0) return false;
+    out = neg ? -v : v;
+    return true;
+}
+
+int lean_stoi(std::string_view w) {
+    int64_t v;
+    if (fast_leading_int(w, 9, v)) return static_cast<int>(v);
+    return word_stoi(w);
+}
+
+long long lean_stoll(std::string_view w) {
+    int64_t v;
+    if (fast_leading_int(w, 18, v)) return v;
+    return word_stoll(w);
+}
+
+bool lean_try_parse_int(std::string_view s, int64_t& out) {
+    if (s.empty()) return false;
+    const char c = s[0];
+    // strtoll converts nothing from a letter, so the original says no.
+    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')) return false;
+    size_t i = c == '-' ? 1 : 0;
+    const size_t d0 = i;
+    while (i < s.size() && s[i] >= '0' && s[i] <= '9') ++i;
+    if (i == s.size() && i > d0 && i - d0 <= 18) {
+        int64_t v;
+        fast_leading_int(s, 18, v);
+        out = v;
+        return true;
+    }
+    return try_parse_int(std::string(s), out);
+}
+
