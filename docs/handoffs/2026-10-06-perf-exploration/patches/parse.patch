+MidiFile MidiFile::lean(const uint8_t* data, size_t size, const MidiLeanFilter& filter) {
+    MidiFile mf;
+    if (size < 14 || data[0] != 'M' || data[1] != 'T' || data[2] != 'h' || data[3] != 'd') {
+        throw MidiError("not a MIDI file: missing MThd header");
+    }
+    uint32_t header_len = be32(data, 4);
+    mf.format = be16(data, 8);
+    int16_t division = be16(data, 12);
+    if (division < 0) throw MidiError("SMPTE time division is not supported");
+    mf.ticks_per_beat = division;
+
+    // The same chunk walk as parse(), first collecting each track's bytes and
+    // name (every track is walked, so a bad length throws as before).
+    std::vector<std::pair<size_t, size_t>> ranges;
+    size_t pos = 8 + header_len;
+    while (pos < size) {
+        if (pos + 4 > size || data[pos] != 'M' || data[pos + 1] != 'T' ||
+            data[pos + 2] != 'r' || data[pos + 3] != 'k') {
+            if (pos + 8 > size) break;
+            pos += 8 + be32(data, pos + 4);
+            continue;
+        }
+        uint32_t chunk_len = be32(data, pos + 4);
+        size_t start = pos + 8;
+        size_t end = std::min(start + chunk_len, size);
+        ranges.emplace_back(start, end);
+        MidiTrack t;
+        t.name = track_name_of(data, start, end);
+        mf.tracks.push_back(std::move(t));
+        pos = start + chunk_len;
+    }
+
+    // Then each track keeps only what its role reads: the first track its
+    // tempo and meter, the first drum track the notes the filter names and its
+    // text metas, every EVENTS track its text metas. Dropped messages hand
+    // their delta on, so absolute ticks are unchanged.
+    bool drums_seen = false;
+    for (size_t i = 0; i < mf.tracks.size(); ++i) {
+        MidiTrack& track = mf.tracks[i];
+        const bool tempo = i == 0;
+        const bool drums = !drums_seen && track.name == kDrumsTrackName;
+        if (drums) drums_seen = true;
+        const bool events = track.name == kEventsTrackName;
+        const bool texts = drums || events;
+        if (!tempo && !texts) continue;
+        walk_track(
+            data, ranges[i].first, ranges[i].second,
+            [&](int meta_type, const uint8_t* payload, size_t plen, int64_t pending) {
+                const bool keep = (tempo && (meta_type == 0x51 || meta_type == 0x58)) ||
+                                  (texts && meta_type >= 0x01 && meta_type <= 0x07 &&
+                                   meta_type != 0x03 && meta_type != 0x04);
+                if (!keep) return false;
+                Message msg;
+                if (!meta_message(meta_type, payload, plen, pending, &msg)) return false;
+                track.messages.push_back(std::move(msg));
+                return true;
+            },
+            [&](int high, uint8_t d1, uint8_t d2, int64_t pending) {
+                if (!drums) return false;
+                const uint8_t note = d1 < 128 ? d1 : uint8_t{127};
+                const uint8_t vel = d2 < 128 ? d2 : uint8_t{127};
+                const bool on = high == 0x90 && vel > 0;
+                if (!(on ? filter.note_on[note] : filter.note_off[note])) return false;
+                Message& msg = track.messages.emplace_back();
+                msg.type = (high == 0x90) ? MType::NoteOn : MType::NoteOff;
+                msg.note = note;
+                msg.velocity = vel;
+                msg.time = pending;
+                return true;
+            });
+    }
+    return mf;
+}
