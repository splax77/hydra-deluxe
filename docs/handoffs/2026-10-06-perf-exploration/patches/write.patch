+// PERF EXPERIMENT (write): a statement either owned (finalized at scope end,
+// as Stmt) or borrowed from the cache (reset and unbound at scope end).
+struct UseStmt {
+    sqlite3_stmt* p = nullptr;
+    bool owned = true;
+    UseStmt(sqlite3_stmt* p_, bool owned_) : p(p_), owned(owned_) {}
+    UseStmt(UseStmt&& o) noexcept : p(o.p), owned(o.owned) { o.p = nullptr; }
+    UseStmt(const UseStmt&) = delete;
+    UseStmt& operator=(const UseStmt&) = delete;
+    UseStmt& operator=(UseStmt&&) = delete;
+    ~UseStmt() {
+        if (!p) return;
+        if (owned) {
+            sqlite3_finalize(p);
+        } else {
+            sqlite3_reset(p);
+            sqlite3_clear_bindings(p);
+        }
+    }
+    operator sqlite3_stmt*() const { return p; }
+};
+
+UseStmt use_stmt(sqlite3* db, std::unordered_map<std::string, sqlite3_stmt*>& cache, bool on,
+                 const std::string& sql, bool read) {
+    if (!on) {
+        Stmt s = prepare_as(db, sql.c_str(), read);
+        sqlite3_stmt* p = s.p;
+        s.p = nullptr;
+        return UseStmt(p, true);
+    }
+    auto it = cache.find(sql);
+    if (it == cache.end()) {
+        Stmt s = prepare_as(db, sql.c_str(), read);
+        it = cache.emplace(sql, s.p).first;
+        s.p = nullptr;
+    }
+    return UseStmt(it->second, false);
+}
