+// PERF EXPERIMENT (write): where the save path's time goes, summed over the
+// run (consumer thread only, so no locking).
+enum PerfPart {
+    kPartTempomap, kPartBegin, kPartUpsert, kPartLength, kPartPurge1, kPartPurge2,
+    kPartInsert, kPartNodes, kPartGc, kPartDynamics, kPartCommit, kPartCount
+};
+double g_perf_parts[kPartCount] = {};
+struct PerfLap {
+    std::chrono::steady_clock::time_point t = std::chrono::steady_clock::now();
+    void mark(PerfPart p) {
+        const auto now = std::chrono::steady_clock::now();
+        g_perf_parts[p] += std::chrono::duration<double, std::milli>(now - t).count();
+        t = now;
+    }
+    void reset() { t = std::chrono::steady_clock::now(); }
+};
+
