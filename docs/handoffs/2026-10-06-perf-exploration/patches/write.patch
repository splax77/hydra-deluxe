+void RecordStore::ctl(const char* sql) {
+    if (!stmt_cache_on_) {
+        exec(sql);
+        return;
+    }
+    // Transaction control reads as read-only to sqlite3_stmt_readonly.
+    UseStmt s = use_stmt(db_, stmt_cache_, true, sql, true);
+    if (sqlite3_step(s) != SQLITE_DONE)
+        throw KindedError(ErrorKind::DatabaseWrite,
+                          std::string("sqlite exec failed: ") + sqlite3_errmsg(db_));
+}
+
+void RecordStore::begin_save_group() {
+    mutex_.lock();
+    try {
+        ctl("BEGIN");
+    } catch (...) {
+        mutex_.unlock();
+        throw;
+    }
+    group_open_ = true;
+    group_lost_ = false;
+}
+
+void RecordStore::commit_save_group() {
+    if (!group_open_) return;
+    group_open_ = false;
+    try {
+        if (group_lost_)
+            throw KindedError(ErrorKind::DatabaseWrite,
+                              "the save group's transaction was rolled back");
+        ctl("COMMIT");
+    } catch (...) {
+        group_lost_ = false;
+        rollback_if_open(db_);
+        mutex_.unlock();
+        throw;
+    }
+    mutex_.unlock();
+}
