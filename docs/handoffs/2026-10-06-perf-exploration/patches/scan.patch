+std::string hex_digest(const UCHAR (&digest)[16]) {
+    static const char* kHexDigits = "0123456789abcdef";
+    std::string s(32, '0');
+    for (int i = 0; i < 16; ++i) {
+        s[static_cast<size_t>(2 * i)] = kHexDigits[digest[i] >> 4];
+        s[static_cast<size_t>(2 * i + 1)] = kHexDigits[digest[i] & 0xF];
+    }
+    return s;
+}
