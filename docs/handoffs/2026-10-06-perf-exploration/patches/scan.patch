+// PERF EXPERIMENT (scan): one folder's share of the walk, the serial walk's
+// loop body: the charts it holds, in walk order, and its subfolders' paths in
+// listing order.
+void scan_folder(const std::string& dir, const std::string& origin,
+                 const std::vector<DirEntry>& entries, std::vector<PendingChart>& charts,
+                 std::vector<std::string>& subpaths) {
+    // The folder's files, by name and entry in the same order, so the
+    // notes-file pick's index leads back to the entry (pending_chart_of
+    // fingerprints it).
+    std::vector<std::string> file_names;
+    std::vector<const DirEntry*> files;
+    std::vector<const DirEntry*> found_archives;
+    for (const DirEntry& e : entries) {
+        if (e.is_dir) {
+            subpaths.push_back(join_folder(dir, e.name));
+            continue;
+        }
+        file_names.push_back(e.name);
+        files.push_back(&e);
+        if (chart_kind_of(e.name) != ChartKind::Folder) found_archives.push_back(&e);
+    }
+
+    std::string rootfolder = relpath(parent_folder(dir), origin);
+    const auto add_chart = [&](const DirEntry& chart) {
+        std::optional<PendingChart> pc = pending_chart_of(dir, chart, entries);
+        if (!pc) return;
+        pc->rootfolder = rootfolder;
+        charts.push_back(std::move(*pc));
+    };
+    const std::optional<NotesFilePick> pick = pick_notes_file(file_names);
+    if (pick) add_chart(*files[pick->index]);
+    for (const DirEntry* archive : found_archives) add_chart(*archive);
+}
+
+struct WalkNode {
+    std::string dir;
+    std::string origin;
+    std::vector<PendingChart> charts;
+    std::vector<size_t> children;  // in listing order
+    std::string error;
+};
+
+// PERF EXPERIMENT (scan): HYDRA_SCAN_PWALK=N lists folders on N threads, then
+// replays the serial walk's stack order over the finished tree, so `pending`
+// and `errors` come out exactly as the serial walk leaves them.
+void parallel_walk(const std::vector<std::string>& rootfolders, int nthreads,
+                   const std::atomic<bool>* cancel, std::vector<PendingChart>& pending,
+                   std::vector<std::string>& errors, int& folders_seen) {
+    std::deque<WalkNode> nodes;  // references stay valid across push_back
+    std::vector<size_t> roots;
+    std::unordered_set<std::string> visited;
+    for (const std::string& root : rootfolders) {
+        if (is_directory_utf8(root)) {
+            nodes.push_back(WalkNode{root, root, {}, {}, {}});
+            roots.push_back(nodes.size() - 1);
+        }
+        visited.insert(root);
+    }
+
+    std::mutex mu;
+    std::condition_variable cv;
+    std::vector<size_t> queue(roots.begin(), roots.end());
+    size_t in_flight = 0;
+    const auto worker = [&] {
+        std::unique_lock<std::mutex> lk(mu);
+        for (;;) {
+            cv.wait(lk, [&] { return !queue.empty() || in_flight == 0; });
+            if (queue.empty()) return;  // nothing queued and nobody listing
+            const size_t idx = queue.back();
+            queue.pop_back();
+            ++in_flight;
+            const std::string dir = nodes[idx].dir;
+            const std::string origin = nodes[idx].origin;
+            lk.unlock();
+
+            std::vector<PendingChart> charts;
+            std::vector<std::string> subs;
+            std::string err;
+            if (!(cancel && cancel->load())) {
+                try {
+                    const std::vector<DirEntry> entries = list_dir(dir);
+                    scan_folder(dir, origin, entries, charts, subs);
+                } catch (const std::exception& e) {
+                    err = e.what();
+                }
+            }
+
+            lk.lock();
+            nodes[idx].charts = std::move(charts);
+            nodes[idx].error = std::move(err);
+            for (std::string& s : subs) {
+                if (!visited.insert(s).second) continue;
+                nodes.push_back(WalkNode{std::move(s), origin, {}, {}, {}});
+                nodes[idx].children.push_back(nodes.size() - 1);
+                queue.push_back(nodes.size() - 1);
+            }
+            --in_flight;
+            cv.notify_all();
+        }
+    };
+    std::vector<std::thread> threads;
+    for (int t = 0; t < nthreads; ++t) threads.emplace_back(worker);
+    for (std::thread& t : threads) t.join();
+
+    // The serial walk's order: a stack seeded with the roots, each popped
+    // folder's charts, then its subfolders pushed in listing order.
+    std::vector<size_t> stack(roots.begin(), roots.end());
+    while (!stack.empty()) {
+        WalkNode& n = nodes[stack.back()];
+        stack.pop_back();
+        if (!n.error.empty()) errors.push_back(std::move(n.error));
+        for (PendingChart& pc : n.charts) pending.push_back(std::move(pc));
+        for (size_t c : n.children) stack.push_back(c);
+    }
+    folders_seen = static_cast<int>(visited.size());
+}
