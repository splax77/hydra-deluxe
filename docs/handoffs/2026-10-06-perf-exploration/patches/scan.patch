+// HYDRA_SCAN_HASHIO=1: CreateFileW + ReadFile with FILE_FLAG_SEQUENTIAL_SCAN,
+// a per-thread reused buffer of HYDRA_SCAN_HASHBUF_KB (default 1024) KB.
+// A read error ends the loop, as fread's 0 does in the stock path.
+HashedFile stream_md5_win32(BCRYPT_ALG_HANDLE alg, const std::string& path,
+                            size_t head_capture, size_t bufsize) {
+    HANDLE h = CreateFileW(win32_path(path).c_str(), GENERIC_READ,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+                           FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+    if (h == INVALID_HANDLE_VALUE)
+        throw KindedError(ErrorKind::SongFileMissing, "cannot open file: " + path);
+    BCRYPT_HASH_HANDLE hash = nullptr;
+    if (!BCRYPT_SUCCESS(BCryptCreateHash(alg, &hash, nullptr, 0, nullptr, 0, 0))) {
+        CloseHandle(h);
+        throw KindedError(ErrorKind::HashFailed, "MD5 hashing failed");
+    }
+    thread_local std::vector<uint8_t> buf;
+    if (buf.size() != bufsize) buf.resize(bufsize);
+    HashedFile out;
+    DWORD got = 0;
+    while (ReadFile(h, buf.data(), static_cast<DWORD>(buf.size()), &got, nullptr) && got > 0) {
+        BCryptHashData(hash, buf.data(), got, 0);
+        if (out.head.size() < head_capture) {
+            size_t want = std::min(head_capture - out.head.size(), static_cast<size_t>(got));
+            out.head.insert(out.head.end(), buf.data(), buf.data() + want);
+        }
+    }
+    CloseHandle(h);
+    UCHAR digest[16];
+    bool ok = BCRYPT_SUCCESS(BCryptFinishHash(hash, digest, sizeof(digest), 0));
+    BCryptDestroyHash(hash);
+    if (!ok) throw KindedError(ErrorKind::HashFailed, "MD5 hashing failed");
+    out.md5 = hex_digest(digest);
+    return out;
+}
