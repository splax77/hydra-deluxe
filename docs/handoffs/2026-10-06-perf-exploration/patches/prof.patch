diff --git a/src/core/phase_prof.cpp b/src/core/phase_prof.cpp
new file mode 100644
index 0000000..edb3c07
--- /dev/null
+++ b/src/core/phase_prof.cpp
@@ -0,0 +1,114 @@
+// PERF EXPERIMENT ONLY (perf-prof). See phase_prof.h.
+#define _CRT_SECURE_NO_WARNINGS
+#include "core/phase_prof.h"
+
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <vector>
+
+namespace hydra::prof {
+
+namespace {
+std::array<std::atomic<int64_t>, kCount> g_ticks{};
+std::array<std::atomic<int64_t>, kCount> g_calls{};
+std::vector<ChartRow> g_rows;
+std::atomic<int> g_next_worker{0};
+int64_t g_t0 = now();
+
+int64_t freq() {
+    static const int64_t f = [] {
+        LARGE_INTEGER li;
+        QueryPerformanceFrequency(&li);
+        return static_cast<int64_t>(li.QuadPart);
+    }();
+    return f;
+}
+
+const char* kNames[kCount] = {
+    "OpenStore", "CacheLoad", "ScanTotal", "ScanWalk", "ScanListDir", "ScanReadStage",
+    "LibrarySave", "Plan", "BatchRun",
+    "ScanCacheHit", "ScanOpen", "ScanRead", "ScanMd5", "ScanIni", "ScanArchiveMeta",
+    "ScanWorkerTotal", "ScanQueueWait", "ScanConsumerIdle", "ScanConsume",
+    "Parse", "GraphBuild", "MainEnumerate", "MainEngine", "MainRebuild", "AzEnumerate",
+    "AzEngine", "AzRebuild", "OtherSearch", "PrepareRow", "Dynamics", "SongLength",
+    "WorkerTotal", "BatchQueueWait",
+    "BatchConsumerIdle", "SaveTempomap", "SaveBegin", "SaveNaming", "SaveUpsertSong",
+    "SaveLength", "SaveUnreadablePurge", "SaveReplacePurge", "SaveInsertResult",
+    "SavePathNodes", "SaveOrphanGc", "SaveDynamics", "SaveCommit", "SaveTotal",
+    "ConsumerCallbacks",
+};
+}  // namespace
+
+std::atomic<int> g_pool_kind{0};
+
+const char* phase_name(int p) { return kNames[p]; }
+
+int64_t now() {
+    LARGE_INTEGER li;
+    QueryPerformanceCounter(&li);
+    return static_cast<int64_t>(li.QuadPart);
+}
+
+double ticks_to_ms(int64_t t) { return 1000.0 * static_cast<double>(t) / static_cast<double>(freq()); }
+
+ChartTicks& chart_ticks() {
+    thread_local ChartTicks t{};
+    return t;
+}
+void reset_chart_ticks() { chart_ticks().fill(0); }
+
+void add(int p, int64_t ticks) {
+    g_ticks[p].fetch_add(ticks, std::memory_order_relaxed);
+    g_calls[p].fetch_add(1, std::memory_order_relaxed);
+    chart_ticks()[p] += ticks;
+}
+
+int& search_ctx() {
+    thread_local int c = 0;
+    return c;
+}
+
+int worker_index() {
+    thread_local int w = g_next_worker.fetch_add(1);
+    return w;
+}
+
+void record_chart(ChartRow row) { g_rows.push_back(std::move(row)); }
+
+void report() {
+    std::printf("\n==== PHASE PROFILE (ms; calls) ====\n");
+    for (int p = 0; p < kCount; ++p)
+        std::printf("PROF %-20s %12.1f ms %9lld calls\n", kNames[p], ticks_to_ms(g_ticks[p].load()),
+                    static_cast<long long>(g_calls[p].load()));
+    const char* csv = std::getenv("HYDRA_PROF_CSV");
+    if (!csv || !*csv) return;
+    FILE* f = std::fopen(csv, "wb");
+    if (!f) {
+        std::printf("PROF cannot write %s\n", csv);
+        return;
+    }
+    std::fprintf(f, "path,file_size,notes,worker,start_ms,end_ms,failed");
+    for (int p = 0; p < kCount; ++p) std::fprintf(f, ",%s", kNames[p]);
+    std::fprintf(f, "\n");
+    for (const ChartRow& r : g_rows) {
+        std::string q = r.path;
+        for (char& c : q)
+            if (c == '"') c = '\'';
+        std::fprintf(f, "\"%s\",%lld,%lld,%d,%.3f,%.3f,%d", q.c_str(),
+                     static_cast<long long>(r.file_size), static_cast<long long>(r.notes),
+                     r.worker, ticks_to_ms(r.start - g_t0), ticks_to_ms(r.end - g_t0),
+                     r.failed ? 1 : 0);
+        for (int p = 0; p < kCount; ++p) std::fprintf(f, ",%.3f", ticks_to_ms(r.ticks[p]));
+        std::fprintf(f, "\n");
+    }
+    std::fclose(f);
+    std::printf("PROF wrote %zu chart rows to %s\n", g_rows.size(), csv);
+}
+
+}  // namespace hydra::prof
diff --git a/src/core/phase_prof.h b/src/core/phase_prof.h
new file mode 100644
index 0000000..4a778de
--- /dev/null
+++ b/src/core/phase_prof.h
@@ -0,0 +1,74 @@
+// PERF EXPERIMENT ONLY (perf-prof): cheap phase timers for a whole-library
+// hydra_batch run. Global relaxed atomics, QueryPerformanceCounter ticks.
+#ifndef HYDRA_CORE_PHASE_PROF_H
+#define HYDRA_CORE_PHASE_PROF_H
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+namespace hydra::prof {
+
+enum Phase : int {
+    // top level (calling thread)
+    OpenStore, CacheLoad, ScanTotal, ScanWalk, ScanListDir, ScanReadStage, LibrarySave, Plan,
+    BatchRun,
+    // scan read workers
+    ScanCacheHit, ScanOpen, ScanRead, ScanMd5, ScanIni, ScanArchiveMeta, ScanWorkerTotal,
+    ScanQueueWait, ScanConsumerIdle, ScanConsume,
+    // analysis workers
+    Parse, GraphBuild, MainEnumerate, MainEngine, MainRebuild, AzEnumerate, AzEngine,
+    AzRebuild, OtherSearch, PrepareRow, Dynamics, SongLength, WorkerTotal,
+    BatchQueueWait,
+    // consumer
+    BatchConsumerIdle, SaveTempomap, SaveBegin, SaveNaming, SaveUpsertSong, SaveLength,
+    SaveUnreadablePurge, SaveReplacePurge, SaveInsertResult, SavePathNodes, SaveOrphanGc,
+    SaveDynamics, SaveCommit, SaveTotal, ConsumerCallbacks,
+    kCount
+};
+
+const char* phase_name(int p);
+
+int64_t now();             // QPC ticks
+double ticks_to_ms(int64_t t);
+
+void add(int p, int64_t ticks);
+
+// Per-chart accumulator on the current thread (analysis workers / consumer).
+using ChartTicks = std::array<int64_t, kCount>;
+ChartTicks& chart_ticks();
+void reset_chart_ticks();
+
+// Which pool is running (0 scan, 1 batch): picks the queue-wait phase.
+extern std::atomic<int> g_pool_kind;
+// Which search a run_search belongs to on this thread (0 other, 1 main, 2 all-0).
+int& search_ctx();
+
+struct Scope {
+    int p;
+    int64_t t0;
+    explicit Scope(int phase) : p(phase), t0(now()) {}
+    ~Scope() { add(p, now() - t0); }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+};
+
+// One analyzed chart's row for the CSV.
+struct ChartRow {
+    std::string path;
+    int64_t file_size = 0;
+    int64_t notes = -1;
+    int worker = -1;
+    int64_t start = 0, end = 0;  // QPC ticks
+    ChartTicks ticks{};
+    bool failed = false;
+};
+void record_chart(ChartRow row);  // consumer thread only
+int worker_index();                // stable small index per thread
+
+void report();  // prints totals; writes CSV to %HYDRA_PROF_CSV% if set
+
+}  // namespace hydra::prof
+
+#endif
