      "question": "How many milliseconds is a second (probe)?",
      "owner": "s_to_ms and ms_to_s in tools/ch_probe/constants.py",
      "owner_file": "tools/ch_probe/constants.py",
      "owner_symbol": "s_to_ms",
      "date": "2026-10-05",
      "decision": "J3-7 (findings 229, 230, 231, 271, 272 and the probe's unit factor)",
      "added_by": "J3-7",
      "pattern": "\\b\\w*(_s|_S|raw|est|clock|back|front)\\s*\\*\\s*1000(\\.0)?(?![\\d.])|\\b\\w*(_ms|_MS)\\s*/\\s*1000(\\.0)?(?![\\d.])|\\)\\s*[*/]\\s*1000(\\.0)?(?![\\d.])|\\b(ms\\[\\d+\\]|s(\\[\\d+\\])?)\\s*[*/]\\s*1000(\\.0)?(?![\\d.])",
      "language": "py",
      "must_match": [
        "window_ms=dbl(C.OFF_TOTAL_WINDOW) * 1000.0,",
        "self._pending = (self._spacing_ms, thread_context.xmm0_double() * 1000.0)",
        "return ms[0] / 1000",
        "ms[0] += round(s * 1000)"
      ],
      "must_not_match": [
        "bpm_microbeats = int(round(bpm * 1000))",
        "f\"  0 = B {int(BPM * 1000)}\",",
        "\"-i\", \"anullsrc=r=44100:cl=stereo\","
      ],
      "scope": [
        "tools"
      ],
      "note": "The owners multiply by MS_PER_S and so match nothing here. The bare-name alternative catches a variable called just ms or s with an optional subscript."
    },
