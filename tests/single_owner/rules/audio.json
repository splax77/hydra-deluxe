{
  "rules": [
    {
      "question": "How many ms do audio frames last, and how many frames do ms hold?",
      "owner": "ms_of_frames and frames_of_ms in src/audio/frames.h",
      "owner_file": "src/audio/frames.h",
      "owner_symbol": "ms_of_frames",
      "date": "2026-10-04",
      "decision": "audit findings 182 and R7.21",
      "added_by": "FX-P",
      "pattern": "\\*\\s*1000(\\.0)?\\s*/\\s*[\\w.>()-]*([sS]ample_?[rR]ate|[rR]ate)|\\*\\s*[\\w.>-]*([sS]ample_?[rR]ate|[rR]ate)\\w*(\\(\\))?\\s*/\\s*1000(\\.0)?\\b",
      "anchor": "1000",
      "must_match": [
        "seek_frames(static_cast<int64_t>(std::llround(ms * sample_rate_ / 1000.0)));",
        "return sample_rate_ > 0 ? length_ * 1000.0 / sample_rate_ : 0.0;",
        "return static_cast<double>(audio.length_frames()) * 1000.0 / audio.sample_rate() -",
        "front_pad = static_cast<int64_t>(std::llround(-offset_ms * kOutRate / 1000.0));"
      ],
      "must_not_match": [
        "return audio::ms_of_frames(audio.length_frames(), audio.sample_rate()) - audio_offset_ms;",
        "front_pad = audio::frames_of_ms(-offset_ms, kOutRate);",
        "const double seconds = ms / 1000.0;"
      ],
      "owner_lines": [
        {
          "file": "src/audio/frames.h",
          "line_text": "return sample_rate > 0 ? static_cast<double>(frames) * 1000.0 / sample_rate : 0.0;",
          "why": "ms_of_frames, the owner"
        },
        {
          "file": "src/audio/frames.h",
          "line_text": "return static_cast<int64_t>(std::llround(ms * sample_rate / 1000.0));",
          "why": "frames_of_ms, the owner"
        }
      ],
      "note": "Frames times 1000 over a sample rate, or ms times a rate over 1000, written out instead of calling the frames helpers. Decided by: audit findings 182 and R7.21; derive-once review of M_D, preview finding 2 (phase 3 task FX-P)"
    },
    {
      "question": "How does chart time become audio time, and back?",
      "owner": "audio_ms_of_chart_ms and chart_ms_of_audio_ms in src/audio/frames.h",
      "owner_file": "src/audio/frames.h",
      "owner_symbol": "audio_ms_of_chart_ms",
      "date": "2026-10-05",
      "decision": "D69",
      "added_by": "M7-2c",
      "pattern": "\\w*chart_ms\\s*[+-]\\s*audio_offset_ms|\\bms\\s*[+-]\\s*audio_offset_ms_|-\\s*audio_offset_ms\\b",
      "anchor": "audio_offset_ms",
      "must_match": [
        "playhead_->seek_ms(ms + audio_offset_ms_);",
        "return chart_ms + audio_offset_ms;",
        "return audio::ms_of_frames(audio.length_frames(), audio.sample_rate()) - audio_offset_ms;"
      ],
      "must_not_match": [
        "playhead_->seek_ms(audio_ms_of_chart_ms(ms, audio_offset_ms_));",
        "front_pad = frames_of_ms(-offset_ms, kOutRate);"
      ],
      "owner_lines": [
        {
          "file": "src/audio/frames.h",
          "line_text": "return chart_ms + audio_offset_ms;",
          "why": "audio_ms_of_chart_ms, the owner"
        },
        {
          "file": "src/audio/frames.h",
          "line_text": "return audio_ms - audio_offset_ms;",
          "why": "chart_ms_of_audio_ms, the owner"
        }
      ],
      "note": "Moving between chart time and audio time with the offset written out, either way, instead of calling the sync rule's two owners. Decided by: derive-once review of M7-2c, finding 2 (phase 7 task PV join); moved into hydra_audio by D69 (phase 7 task AL1)"
    },
    {
