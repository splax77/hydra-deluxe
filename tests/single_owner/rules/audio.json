        "reserv = std::min(kMaxReservoir, std::min(reserv, static_cast<int>(s.back[j])) +"
      ],
      "must_not_match": [
        "reserv = reservoir_after(reserv, back, s.own[j]);"
      ],
      "owner_lines": [
