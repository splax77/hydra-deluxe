      "owner_file": "src/audio/player.h",
      "owner_symbol": "set_gain",
      "date": "2026-10-04",
      "decision": "D53",
      "added_by": "J1-4",
      "pattern": "gain < 0\\.0f \\? 0\\.0f",
      "anchor": "gain < 0.0f ? 0.0f",
      "must_match": [
        "gain_ = gain < 0.0f ? 0.0f : gain;"
      ],
      "must_not_match": [
        "float gain() const { return gain_; }"
      ],
      "owner_lines": [
        {
          "file": "src/audio/player.h",
          "line_text": "void set_gain(float gain) { gain_ = gain < 0.0f ? 0.0f : gain; }",
          "why": "Playhead::set_gain, the owner"
        }
      ],
      "note": "---- audio owners (phase 6 task J1-4) ---- The frame pair's row is phase 3's (\"How many ms do audio frames last...\", above). Decided by: audit finding 225, folded under D53 (phase 6 task J1-4)"
    },
