    {
      "question": "How many frames are the Opus packet and pre-roll?",
      "owner": "frames_of_ms in src/audio/frames.h",
      "owner_file": "src/audio/frames.h",
      "owner_symbol": "frames_of_ms",
      "date": "2026-10-05",
      "decision": "D53",
      "added_by": "J2-6",
      "pattern": "\\b(5760|19200)\\b",
      "must_match": [
        "constexpr int kMaxFrame = 5760;        // 120 ms, the largest Opus packet",
        "constexpr int64_t kPreRoll = 19200;    // 400 ms decoder warm-up before a seek target"
      ],
      "must_not_match": [
        "const int kMaxFrame = static_cast<int>(frames_of_ms(120.0, kRate));",
        "const int64_t kPreRoll = frames_of_ms(400.0, kRate);"
      ],
      "scope": [
        "src"
      ],
      "note": "Decided by: audit finding 227; phase 6 task J2-6 (D53)"
    },
    {
      "question": "How many reservoir bytes does an MP3 frame leave?",
      "owner": "reservoir_after in src/audio/ma_reader.cpp",
      "owner_file": "src/audio/ma_reader.cpp",
      "owner_symbol": "reservoir_after",
      "date": "2026-10-05",
