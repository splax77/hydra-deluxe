      ],
      "owner_lines": [
        {
          "file": "src/ui/widgets.h",
          "line_text": "window->DrawList->AddText(window->DC.CursorPos, ImGui::GetColorU32(ImGuiCol_Text),",
          "why": "draw_cut_text, the owner: the cut text at the cursor"
