      "added_by": "D115-A2-5-review",
      "pattern": "AddText\\(\\s*window->DC\\.CursorPos",
      "anchor": "DC.CursorPos",
      "must_match": [
        "window->DrawList->AddText(window->DC.CursorPos, ImGui::GetColorU32(ImGuiCol_Text),",
