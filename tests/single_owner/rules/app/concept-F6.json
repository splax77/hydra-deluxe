      "owner": "batch_counts_text in src/app/analysis.cpp",
      "owner_file": "src/app/analysis.cpp",
      "owner_symbol": "batch_counts_text",
      "date": "2026-10-11",
      "decision": "D114 item 10 (concept audit M24)",
      "added_by": "concept-F6",
      "pattern": "already stored|already had a result",
      "owner_files": [
        "src/app/analysis.cpp"
      ],
      "must_match": [
        "std::printf(\"\\nAnalyzed %s, skipped %s already stored, %s failed in %.1fs.\\n\",",
