{
    "name": "ch-mcp-agent",
    "version": "0.0.0",
    "private": true,
    "description": "Frida agents that read Clone Hero's state by field name, trace its methods, and drive a virtual drum kit inside it. What they may change in the game is in docs/agents/clone-hero-mcp.md, Safety rules. Each build writes a stamp beside its .js that the loaders check (tools/ch_mcp/build_stamp.py).",
    "type": "module",
    "scripts": {
        "build:clock": "frida-compile -o clock.js clock.ts && py -I ../build_stamp.py clock.js",
        "build:trace": "frida-compile -o trace.js trace.ts && py -I ../build_stamp.py trace.js",
        "build:state": "frida-compile -o state.js state.ts && py -I ../build_stamp.py state.js",
        "build:menuhooks": "frida-compile -o menuhooks.js menuhooks.ts && py -I ../build_stamp.py menuhooks.js",
        "build:kit": "frida-compile -o kit.js kit.ts && py -I ../build_stamp.py kit.js",
        "build:launch": "frida-compile -o launch.js launch.ts && py -I ../build_stamp.py launch.js"
    },
    "devDependencies": {
        "@types/frida-gum": "^19.10.0",
        "frida-compile": "19.1.0",
        "frida-il2cpp-bridge": "0.14.0"
    }
}
