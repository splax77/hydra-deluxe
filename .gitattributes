* text=auto

# The chart corpus and binary assets must never go through CRLF
# normalization; a converted .mid silently breaks parsing.
*.mid binary
*.chart -text
*.sng binary
*.srb binary
*.db binary
*.ttf binary
*.png binary
*.PNG binary
*.ico binary
*.bin binary
*.sig binary

# The session-card tools record each card's sha, so a card's line endings
# must not change on checkout.
docs/sessions/*.md -text
